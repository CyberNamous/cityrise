{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cityrise",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./public", "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "cityrise-db",
    // Replace with the database_id returned by `npx wrangler d1 create cityrise-db`.
    "database_id": "aa4e61d7-4b36-42b5-8687-ad5e1f722ae3"
  }]
}
