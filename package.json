{
  "name": "cityrise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first isometric city builder for Cloudflare Workers and D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute cityrise-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute cityrise-db --remote --file=schema.sql",
    "check": "node --check src/index.js && node --check public/scripts/main.js",
    "verify": "node validate.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
